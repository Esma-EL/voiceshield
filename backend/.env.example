# Copy to .env and fill in to enable the real (non-fallback) engines.

# Frontend origin for CORS (default works for `npm run dev`).
FRONTEND_ORIGIN=http://localhost:3000

# --- Access control (optional) ---
# If set, every /api/* request (except /api/health) must send this value in the
# `X-API-Key` header. Leave empty for open demo mode.
# API_KEY=change-me-to-a-long-random-string

# --- Abuse protection ---
# Max accepted audio upload size in bytes (default 10 MiB).
# MAX_UPLOAD_BYTES=10485760
# Per-IP request cap over a 60s sliding window (0 disables it).
# RATE_LIMIT_PER_MINUTE=60

# --- Voice anti-spoofing model (optional) ---
# A HuggingFace / ModelScope audio-classification checkpoint.
# Leave empty to use the acoustic-feature heuristic.
# SPOOFING_MODEL_ID=MelodyMachine/Deepfake-audio-detection-V2

# --- Qwen context analysis via DashScope (optional) ---
# Leave empty to use the French rule engine.
# DASHSCOPE_API_KEY=sk-xxxxxxxx
# QWEN_MODEL=qwen-plus

# --- Verdict thresholds (combined risk 0..1) ---
# RISK_AMBER=0.40
# RISK_RED=0.65
